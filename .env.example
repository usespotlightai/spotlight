# Signs people in. Use the GitHub App's own client ID and a client secret
# generated on the App
# Callback URL: https://app.dev.usespotlight.ai/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App is used to clone and push. Install it on the repos you want
# Spotlight to work on, and give it contents: write.
# Set the App's Setup URL to https://app.dev.usespotlight.ai/github/installed and
# tick "Redirect on update", so the Install button in Spotlight brings people
# back to the team they left from. The App's own name is asked of GitHub, so
# there is nothing to configure here for it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# The webhook secret from the same App. GitHub signs each delivery with it,
# and a task moves to Completed when its pull request is merged.
# Webhook URL: https://app.usespotlight.ai/api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# Wraps each workspace's data key, which seals secrets and host connection
# tokens in the database. Losing it means setting every secret again and
# reconnecting each integration. compose.yml has a development default.
# Generate with: openssl rand -base64 32
SPOTLIGHT_SECRETS_KEY=

# Cloudflare tunnel token, so webhooks reach this machine in development.
# In Cloudflare Zero Trust > Networks > Tunnels, create a tunnel and give it
# one public hostname: app-dev.usespotlight.ai with path api/webhooks,
# pointing at http://control-plane:3000. One label deep: the free Cloudflare
# certificate covers *.usespotlight.ai and nothing under it.
# Then point the App's webhook at
# https://app-dev.usespotlight.ai/api/webhooks/github.
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Spotlight <noreply@usespotlight.ai>

# The dev host serves a pull pool: its token, given once when the pool is
# created. scripts/dev-setup.mjs creates one and writes it here; for a pool
# created on the Runners page, copy the token out of its install command.
# Run `docker compose up -d host` after changing it.
DEV_POOL_TOKEN=
# DEV_HOST_CAPACITY=2

# Agent credentials. Set one for Claude Code; OPENAI_API_KEY is for Codex and
# CURSOR_API_KEY for Cursor.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
CURSOR_API_KEY=

# The author of the commits agents make.
# SPOTLIGHT_GIT_AUTHOR_NAME=Spotlight
# SPOTLIGHT_GIT_AUTHOR_EMAIL=noreply@usespotlight.ai

# The OpenRouter key the control plane drafts change stacks, agent decisions and
# team memories with, and judges runs with; all four are unavailable without it.
# CHANGE_STACK_MODEL, DECISIONS_MODEL, MEMORIES_MODEL and JUDGE_MODEL pick their
# OpenRouter models, google/gemini-3.8-flash by default.
# OPENROUTER_API_KEY=
# CHANGE_STACK_MODEL=
# DECISIONS_MODEL=
# MEMORIES_MODEL=
# JUDGE_MODEL=

# Hosts integrations and tools may call, comma separated. compose.yml defaults
# it to slack.com; set it here to allow more.
# OUTBOUND_ALLOWED_HOSTS=slack.com

# The shared OAuth2 apps integrations sign in with, per source, as JSON.
# OAUTH_CLIENTS={"slack":{"id":"...","secret":"..."}}
