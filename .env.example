# Signs people in. Use the GitHub App's own client ID and a client secret
# generated on the App
# Callback URL: https://app.usespotlight.ai/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App is used to clone and push. Install it on the repos you want
# Spotlight to work on, and give it contents: write.
# Set the App's Setup URL to https://app.usespotlight.ai/github/installed and
# tick "Redirect on update", so the Install button in Spotlight brings people
# back to the team they left from. The App's own name is asked of GitHub, so
# there is nothing to configure here for it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# The webhook secret from the same App. GitHub signs each delivery with it,
# and a task moves to Completed when its pull request is merged.
# Webhook URL: https://app.usespotlight.ai/api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# Seals what Spotlight keeps in its database but must not hold in the clear:
# each team's key for .spotlight/secrets.vault, and host connection tokens.
# Losing it means Spotlight can no longer open any team's vault; a team that
# kept its key (Settings > Secrets) can still decrypt it with age -d.
# Generate with: openssl rand -base64 32
SPOTLIGHT_SECRETS_KEY=

# Cloudflare tunnel token, so webhooks reach this machine in development.
# In Cloudflare Zero Trust > Networks > Tunnels, create a tunnel and give it
# one public hostname: app-dev.usespotlight.ai with path api/webhooks,
# pointing at http://control-plane:3000. One label deep: the free Cloudflare
# certificate covers *.usespotlight.ai and nothing under it.
# Then point the App's webhook at
# https://app-dev.usespotlight.ai/api/webhooks/github.
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Spotlight <noreply@usespotlight.ai>

# Runner tokens, from Settings > Runners. Each is shown once, when you enrol it.
RUNNER_ONE_TOKEN=
RUNNER_TWO_TOKEN=

# Agent credentials. Set one.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# The OpenRouter key the control plane drafts change stacks with; change stacks
# are unavailable without it. CHANGE_STACK_MODEL picks the OpenRouter model,
# google/gemini-3.8-flash by default.
# OPENROUTER_API_KEY=
# CHANGE_STACK_MODEL=

# Hosts integrations and tools may call, comma separated. compose.yml defaults
# it to slack.com; set it here to allow more.
# OUTBOUND_ALLOWED_HOSTS=slack.com

# Where hosts send webhook deliveries, shown as each integration's delivery
# address. Defaults to SPOTLIGHT_PUBLIC_URL, then BETTER_AUTH_URL. In dev it is
# the Cloudflare tunnel's hostname.
SPOTLIGHT_WEBHOOK_URL=
