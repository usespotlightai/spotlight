# These values sign people in. Use the client ID of the GitHub App and a client
# secret that you generate on the App.
# Callback URL: https://app.dev.usespotlight.ai/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spotlight uses the GitHub App to clone and push. Install the App on the repos
# that Spotlight must work on. Give it contents: write.
# Set the Setup URL of the App to https://app.dev.usespotlight.ai/github/installed
# and select "Redirect on update". Then the Install button in Spotlight sends
# people back to the team that they came from. Spotlight reads the name of the
# App from GitHub. You do not configure it here.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# The webhook secret of the same App. GitHub signs each delivery with it.
# A task moves to Completed when its pull request is merged.
# Webhook URL: https://app.usespotlight.ai/api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# This key wraps the data key of each workspace. The data key seals the secrets
# and host connection tokens in the database. If you lose this key, you must set
# each secret again and connect each integration again. compose.yml has a
# default value for development.
# Generate with: openssl rand -base64 32
SPOTLIGHT_SECRETS_KEY=

# The Cloudflare tunnel token lets webhooks reach this machine in development.
# In Cloudflare Zero Trust > Networks > Tunnels, create a tunnel. Give it one
# public hostname: app-dev.usespotlight.ai with path api/webhooks, to
# http://control-plane:3000. Use only one label before usespotlight.ai. The free
# Cloudflare certificate is only for *.usespotlight.ai, not for deeper names.
# Then set the webhook of the App to
# https://app-dev.usespotlight.ai/api/webhooks/github.
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Spotlight <noreply@usespotlight.ai>

# The token of the pull pool that the dev host serves. Spotlight shows the token
# one time, when the pool is created. scripts/dev-setup.mjs creates a pool and
# writes its token here. For a pool from the Runners page, copy the token from
# its install command. Run `docker compose up -d host` after you change it.
DEV_POOL_TOKEN=
# DEV_HOST_CAPACITY=2

# Agent credentials. For Claude Code, set ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN. OPENAI_API_KEY is for Codex and CURSOR_API_KEY is
# for Cursor.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
CURSOR_API_KEY=

# The author of the commits that agents make.
# SPOTLIGHT_GIT_AUTHOR_NAME=Spotlight
# SPOTLIGHT_GIT_AUTHOR_EMAIL=noreply@usespotlight.ai

# The control plane uses the OpenRouter key to draft change stacks, agent
# decisions and team memories, and to judge runs. These four functions do not
# work without the key. CHANGE_STACK_MODEL, DECISIONS_MODEL, MEMORIES_MODEL and
# JUDGE_MODEL set their OpenRouter models. The default is google/gemini-3.8-flash.
# OPENROUTER_API_KEY=
# CHANGE_STACK_MODEL=
# DECISIONS_MODEL=
# MEMORIES_MODEL=
# JUDGE_MODEL=

# The hosts that integrations and tools can call, separated by commas.
# compose.yml sets slack.com as the default. Set the value here to permit more.
# SPOTLIGHT_OUTBOUND_ALLOWED_HOSTS=slack.com

# The shared OAuth2 apps that integrations sign in with, for each source, in JSON.
# OAUTH_CLIENTS={"slack":{"id":"...","secret":"..."}}

# How often, in seconds, Spotlight lists an MCP server's tools again.
# SPOTLIGHT_MCP_RELIST_SECONDS=600

# How long, in milliseconds, a host's claim waits for work before Spotlight returns nothing.
# SPOTLIGHT_LONG_POLL_MS=10000

# Sentry receives the errors of each part of Spotlight. Each part sends to its
# own Sentry project. The control plane gives the web DSN to the web app. An
# empty DSN stops the part from sending.
# SENTRY_CONTROL_PLANE_DSN=
# SENTRY_WEB_DSN=
# SENTRY_DATA_PLANE_DSN=
