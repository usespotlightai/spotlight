{
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling"
  },
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "paths": {
      "@platform/*": ["./src/platform/*"],
      "@shared-kernel/*": ["./src/shared-kernel/*"],
      "@work/*": ["./src/contexts/work/*"],
      "@runners/*": ["./src/contexts/runners/*"],
      "@change-review/*": ["./src/contexts/change-review/*"],
      "@memory/*": ["./src/contexts/memory/*"],
      "@outcomes/*": ["./src/contexts/outcomes/*"],
      "@replays/*": ["./src/contexts/replays/*"],
      "@github/*": ["./src/contexts/github/*"],
      "@integrations/*": ["./src/contexts/integrations/*"],
      "@configuration/*": ["./src/contexts/configuration/*"],
      "@identity/*": ["./src/contexts/identity/*"],
      "@secrets/*": ["./src/contexts/secrets/*"],
      "@catalog/*": ["./src/contexts/catalog/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}
