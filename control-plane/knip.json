{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "drizzle": false,
  "entry": [
    "src/main.ts",
    "src/**/*.worker.ts",
    "scripts/*.ts",
    "drizzle.config.ts"
  ],
  "ignoreDependencies": ["pino-pretty"],
  "ignoreBinaries": ["terraform"],
  "ignoreIssues": {
    "src/**/persistence/drizzle/schemas/*.schema.ts": ["exports", "types"]
  }
}
