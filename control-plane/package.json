  "scripts": {
    "build": "nest build",
    "format": "oxfmt",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "check": "oxfmt && oxlint --fix",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrations:check": "node scripts/check-migrations.mjs",
    "facts:rebuild": "ts-node -r tsconfig-paths/register src/contexts/insights/presentation/cli/rebuild-run-facts.ts",
    "replay-outcomes:rebuild": "ts-node -r tsconfig-paths/register src/contexts/replays/presentation/cli/rebuild-replay-outcomes.ts",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "auth:generate": "auth generate --config scripts/auth-config.ts --output src/contexts/identity/infrastructure/persistence/drizzle/schemas/auth.schema.ts -y && node scripts/auth-schema-timestamptz.mjs src/contexts/identity/infrastructure/persistence/drizzle/schemas/auth.schema.ts",
    "bench:change-stacks": "ts-node -r tsconfig-paths/register bench/change-stacks/bench.ts"
  },
