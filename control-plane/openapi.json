                    "$ref": "#/components/schemas/AssemblyLineResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "No such team for this caller"
          }
        },
        "summary": "List a team’s assembly lines, each with its stations in order",
