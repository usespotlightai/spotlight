  "info": {
    "title": "Spotlight Control Plane",
    "description": "HTTP API for the Spotlight Control Plane.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "StationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "d41f0a2c-8b7e-4f19-9d3a-6c5e2b1a4f80"
          },
          "name": {
            "type": "string",
            "example": "Triage"
          },
          "position": {
            "type": "number",
            "example": 0,
            "description": "Left to right across the board"
          },
          "description": {
            "type": "string",
            "example": "Where new work lands before anyone looks at it",
            "nullable": true
          },
          "pool": {
            "type": "string",
            "example": "dev",
            "nullable": true,
            "description": "Which runners work this station. Null until one is chosen."
          },
          "agentPrompt": {
            "type": "string",
            "example": "## Role\n\nSort the queue.",
            "nullable": true,
            "description": "Markdown, handed to the agent that works this station"
          }
        },
        "required": [
          "id",
          "name",
          "position",
          "description",
          "pool",
          "agentPrompt"
        ]
      },
      "AssemblyLineResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "7b2c9e14-3a5d-4c8f-b6e1-9d0a2f7c5b43"
          },
          "name": {
            "type": "string",
            "example": "Default"
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "stations"
        ]
      },
      "CustomiseStationRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Triage",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "example": "Where new work lands before anyone looks at it",
            "maxLength": 500,
            "nullable": true
          },
          "pool": {
            "type": "string",
            "example": "dev",
            "maxLength": 60,
            "nullable": true,
            "description": "Which runners work this station"
          },
          "agentPrompt": {
            "type": "string",
            "example": "## Role\n\nSort the queue.",
            "maxLength": 20000,
            "nullable": true,
            "description": "Markdown, handed to the agent that works this station"
          }
        }
      },
      "GreetingResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello World!"
          }
        },
        "required": [
          "message"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "EnqueueRunRequestDto": {
        "type": "object",
        "properties": {
          "pool": {
            "type": "string",
            "example": "dev"
          },
          "spec": {
            "type": "object",
            "description": "Handed to the runner untouched: checkouts, cwd, command",
            "example": {
              "cwd": "service",
              "checkouts": [
                {
                  "remote": "https://github.com/org/service",
                  "path": "service"
                }
              ],
              "command": {
                "executable": "claude",
                "args": [
                  "-p",
                  "fix the build"
                ]
              }
            }
          },
          "targetRunnerId": {
            "type": "string",
            "description": "Runner this run belongs to. Omitted lets any runner in the pool take it.",
            "example": "8a1d4e0b-6c72-4f35-9b8a-1e5d3c7f2a49"
          }
        },
        "required": [
          "pool",
          "spec"
        ]
      },
      "EnqueuedRunResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9c2e6d5a-1f47-4c8b-9a3d-2b7e5f0c1d84"
          },
          "pool": {
            "type": "string",
            "example": "dev"
          },
          "state": {
            "type": "string",
            "example": "queued"
          },
          "targetRunnerId": {
            "type": "object",
            "nullable": true,
            "example": "8a1d4e0b-6c72-4f35-9b8a-1e5d3c7f2a49",
            "description": "The runner it waits for, or null for whoever is free"
          }
        },
        "required": [
          "id",
          "pool",
          "state",
          "targetRunnerId"
        ]
      },
      "SendRunInputRequestDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "example": "bHMgLWxhCg==",
            "description": "Keystrokes as base64, exactly as the terminal produced them"
          },
          "cols": {
            "type": "number",
            "example": 120,
            "description": "New terminal width"
          },
          "rows": {
            "type": "number",
            "example": 40,
            "description": "New terminal height"
          }
        }
      },
      "RunInputResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "example": "bHMgLWxhCg=="
          },
          "cols": {
            "type": "number",
            "example": 120
          },
          "rows": {
            "type": "number",
            "example": 40
          },
          "stop": {
            "type": "boolean",
            "example": true,
            "description": "The agent has been asked to finish"
          }
        }
      },
      "PendingRunInputResponseDto": {
        "type": "object",
        "properties": {
          "input": {
            "description": "Empty when the poll timed out with nothing typed",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunInputResponseDto"
            }
          }
        },
        "required": [
          "input"
        ]
      },
      "RegisteredRunnerResponseDto": {
        "type": "object",
        "properties": {
          "runnerId": {
            "type": "string",
            "example": "3fd46417-95af-4c8b-9a3d-2b7e5f0c1d84"
          }
        },
        "required": [
          "runnerId"
        ]
      },
      "ClaimedRunResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9c2e6d5a-1f47-4c8b-9a3d-2b7e5f0c1d84"
          },
          "spec": {
            "type": "object",
            "description": "Opaque to the control plane, meaningful to the hook"
          },
          "leaseExpiresAt": {
            "type": "string",
            "example": "2026-08-23T18:01:00.000Z"
          }
        },
        "required": [
          "id",
          "spec",
          "leaseExpiresAt"
        ]
      },
      "RunEventRequestDto": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "number",
            "example": 1,
            "description": "Assigned by the runner, gapless"
          },
          "type": {
            "type": "string",
            "example": "output"
          },
          "at": {
            "type": "string",
            "example": "2026-08-23T18:00:00.000Z"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "description": "Terminal bytes, base64"
          },
          "offset": {
            "type": "number",
            "example": 0,
            "description": "Position in the recording"
          }
        },
        "required": [
          "seq",
          "type",
          "at"
        ]
      },
      "AppendRunEventsRequestDto": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunEventRequestDto"
            }
          }
        },
        "required": [
          "events"
        ]
      },
      "CompleteRunRequestDto": {
        "type": "object",
        "properties": {
          "exitCode": {
            "type": "number",
            "example": 0
          },
          "failed": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "exitCode",
          "failed"
        ]
      },
      "ActiveRunResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f9c1b7e-52a4-4d6f-8e1b-0a7c4d2f9b63"
          },
          "state": {
            "type": "string",
            "example": "claimed"
          }
        },
        "required": [
          "id",
          "state"
        ]
      },
      "ConnectedRunnerResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "8a1d4e0b-6c72-4f35-9b8a-1e5d3c7f2a49"
          },
          "name": {
            "type": "string",
            "example": "Build server"
          },
          "pool": {
            "type": "string",
            "example": "dev"
          },
          "registeredAt": {
            "type": "string",
            "example": "2026-08-24T11:00:00.000Z"
          },
          "lastSeenAt": {
            "type": "string",
            "nullable": true,
            "example": "2026-08-24T12:00:00.000Z",
            "description": "Null when the runner has never connected"
          },
          "revokedAt": {
            "type": "string",
            "nullable": true,
            "description": "When its token was retired, if it has been"
          },
          "connected": {
            "type": "boolean",
            "example": true,
            "description": "Heard from recently enough to be counted on"
          },
          "currentRun": {
            "nullable": true,
            "description": "The run it is working on, or null when idle",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ActiveRunResponseDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "pool",
          "registeredAt",
          "lastSeenAt",
          "revokedAt",
          "connected",
          "currentRun"
        ]
      },
      "EnrolRunnerRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Build server",
            "description": "What to call this runner. Rejected if empty or over 60."
          },
          "pool": {
            "type": "string",
            "example": "dev",
            "description": "Which queue this runner may take work from."
          }
        },
        "required": [
          "name",
          "pool"
        ]
      },
      "EnrolledRunnerResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "8a1d4e0b-6c72-4f35-9b8a-1e5d3c7f2a49"
          },
          "name": {
            "type": "string",
            "example": "Build server"
          },
          "token": {
            "type": "string",
            "example": "spot_xY3...",
            "description": "Shown once. Nothing can recover it after this response."
          }
        },
        "required": [
          "id",
          "name",
          "token"
        ]
      },
      "CreateWorkspaceRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Inc.",
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "example": "acme-inc",
            "maxLength": 48,
            "description": "Addresses the workspace at /w/{slug}. Lowercase letters, numbers and single dashes."
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "TeamResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9c2e6d5a-1f47-4c8b-9a3d-2b7e5f0c1d84"
          },
          "name": {
            "type": "string",
            "example": "Acme Inc."
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "WorkspaceResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "5f1c2f0e-6e0a-4a1e-9a4a-0f6d2c1b8e77"
          },
          "name": {
            "type": "string",
            "example": "Acme Inc."
          },
          "slug": {
            "type": "string",
            "example": "acme-inc"
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "teams"
        ]
      },
      "WorkspaceListingResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "5f1c2f0e-6e0a-4a1e-9a4a-0f6d2c1b8e77"
          },
          "name": {
            "type": "string",
            "example": "Acme Inc."
          },
          "slug": {
            "type": "string",
            "example": "acme-inc"
          },
          "role": {
            "type": "string",
            "example": "owner",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      }
    }
  }
}
